---
import { site } from '../data/site';

const year = new Date().getFullYear();

const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
const phone = `tel:+${site.whatsapp}`;

const navigation = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Clientes', href: '#clientes' },
  { label: 'Contacto', href: '#contacto' }
];

const socials = [
  {
    label: 'Facebook',
    url: site.social.facebook,
    icon: `
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M24 0C10.7453 0 0 10.7453 0 24C0 35.255 7.74912 44.6995 18.2026 47.2934V31.3344H13.2538V24H18.2026V20.8397C18.2026 12.671 21.8995 8.8848 29.9194 8.8848C31.44 8.8848 34.0637 9.18336 35.137 9.48096V16.129C34.5706 16.0694 33.5866 16.0397 32.3645 16.0397C28.4294 16.0397 26.9088 17.5306 26.9088 21.4061V24H34.7482L33.4013 31.3344H26.9088V47.8243C38.7926 46.3891 48.001 36.2707 48.001 24C48 10.7453 37.2547 0 24 0Z" fill="currentColor"/>
      </svg>
    `
  },
  {
    label: 'Instagram',
    url: site.social.instagram,
    icon: `
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M24 4.32187C30.4125 4.32187 31.1719 4.35 33.6938 4.4625C36.0375 4.56562 37.3031 4.95938 38.1469 5.2875C39.2625 5.71875 40.0688 6.24375 40.9031 7.07812C41.7469 7.92188 42.2625 8.71875 42.6938 9.83438C43.0219 10.6781 43.4156 11.9531 43.5188 14.2875C43.6313 16.8187 43.6594 17.5781 43.6594 23.9813C43.6594 30.3938 43.6313 31.1531 43.5188 33.675C43.4156 36.0188 43.0219 37.2844 42.6938 38.1281C42.2625 39.2438 41.7375 40.05 40.9031 40.8844C40.0594 41.7281 39.2625 42.2438 38.1469 42.675C37.3031 43.0031 36.0281 43.3969 33.6938 43.5C31.1625 43.6125 30.4031 43.6406 24 43.6406C17.5875 43.6406 16.8281 43.6125 14.3063 43.5C11.9625 43.3969 10.6969 43.0031 9.85313 42.675C8.7375 42.2438 7.93125 41.7188 7.09688 40.8844C6.25313 40.0406 5.7375 39.2438 5.30625 38.1281C4.97813 37.2844 4.58438 36.0094 4.48125 33.675C4.36875 31.1438 4.34063 30.3844 4.34063 23.9813C4.34063 17.5688 4.36875 16.8094 4.48125 14.2875C4.58438 11.9437 4.97813 10.6781 5.30625 9.83438C5.7375 8.71875 6.2625 7.9125 7.09688 7.07812C7.94063 6.23438 8.7375 5.71875 9.85313 5.2875C10.6969 4.95938 11.9719 4.56562 14.3063 4.4625C16.8281 4.35 17.5875 4.32187 24 4.32187ZM24 0C17.4844 0 16.6688 0.028125 14.1094 0.140625C11.5594 0.253125 9.80625 0.665625 8.2875 1.25625C6.70312 1.875 5.3625 2.69062 4.03125 4.03125C2.69063 5.3625 1.875 6.70313 1.25625 8.27813C0.665625 9.80625 0.253125 11.55 0.140625 14.1C0.028125 16.6687 0 17.4844 0 24C0 30.5156 0.028125 31.3312 0.140625 33.8906C0.253125 36.4406 0.665625 38.1938 1.25625 39.7125C1.875 41.2969 2.69063 42.6375 4.03125 43.9688C5.3625 45.3 6.70313 46.125 8.27813 46.7344C9.80625 47.325 11.55 47.7375 14.1 47.85C16.6594 47.9625 17.475 47.9906 23.9906 47.9906C30.5063 47.9906 31.3219 47.9625 33.8813 47.85C36.4313 47.7375 38.1844 47.325 39.7031 46.7344C41.2781 46.125 42.6188 45.3 43.95 43.9688C45.2812 42.6375 46.1063 41.2969 46.7156 39.7219C47.3063 38.1938 47.7188 36.45 47.8313 33.9C47.9438 31.3406 47.9719 30.525 47.9719 24.0094C47.9719 17.4938 47.9438 16.6781 47.8313 14.1188C47.7188 11.5688 47.3063 9.81563 46.7156 8.29688C46.125 6.70312 45.3094 5.3625 43.9688 4.03125C42.6375 2.7 41.2969 1.875 39.7219 1.26562C38.1938 0.675 36.45 0.2625 33.9 0.15C31.3313 0.028125 30.5156 0 24 0Z" fill="currentColor"/>
        <path d="M24 11.6719C17.1938 11.6719 11.6719 17.1938 11.6719 24C11.6719 30.8062 17.1938 36.3281 24 36.3281C30.8062 36.3281 36.3281 30.8062 36.3281 24C36.3281 17.1938 30.8062 11.6719 24 11.6719ZM24 31.9969C19.5844 31.9969 16.0031 28.4156 16.0031 24C16.0031 19.5844 19.5844 16.0031 24 16.0031C28.4156 16.0031 31.9969 19.5844 31.9969 24C31.9969 28.4156 28.4156 31.9969 24 31.9969Z" fill="currentColor"/>
        <path d="M39.6937 11.1843C39.6937 12.778 38.4 14.0624 36.8156 14.0624C35.2219 14.0624 33.9375 12.7687 33.9375 11.1843C33.9375 9.59053 35.2313 8.30615 36.8156 8.30615C38.4 8.30615 39.6937 9.5999 39.6937 11.1843Z" fill="currentColor"/>
      </svg>
    `
  },
  {
    label: 'TikTok',
    url: site.social.tiktok,
    icon: `
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M34.1451 0H26.0556V32.6956C26.0556 36.5913 22.9444 39.7913 19.0725 39.7913C15.2007 39.7913 12.0894 36.5913 12.0894 32.6956C12.0894 28.8696 15.1315 25.7391 18.8651 25.6V17.3913C10.6374 17.5304 4 24.2783 4 32.6956C4 41.1827 10.7757 48 19.1417 48C27.5075 48 34.2833 41.1131 34.2833 32.6956V15.9304C37.3255 18.1565 41.059 19.4783 45 19.5479V11.3391C38.9157 11.1304 34.1451 6.12173 34.1451 0Z" fill="currentColor"/>
      </svg>
    `
  },
  {
    label: 'X',
    url: site.social.x,
    icon: `
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M36.6526 3.8078H43.3995L28.6594 20.6548L46 43.5797H32.4225L21.7881 29.6759L9.61989 43.5797H2.86886L18.6349 25.56L2 3.8078H15.9222L25.5348 16.5165L36.6526 3.8078ZM34.2846 39.5414H38.0232L13.8908 7.63406H9.87892L34.2846 39.5414Z" fill="currentColor"/>
      </svg>
    `
  }
].filter((social) => social.url);
---

<footer class="bg-[#0d0f12] text-white">

  <!-- CTA -->
  <div class="border-b border-white/10">
    <div class="container-site flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="eyebrow text-[var(--brand-orange)]">Hagamos realidad tu idea</p>

        <h2 class="mt-3 max-w-2xl text-2xl font-black tracking-[-.035em] sm:text-3xl">
          ¿Tienes un proyecto en mente?
        </h2>

        <p class="mt-2 max-w-xl text-sm leading-6 text-white/55">
          Cuéntanos qué necesitas y te ayudamos a encontrar la mejor solución
          para hacer destacar tu marca.
        </p>
      </div>

      <a
        href={wa}
        target="_blank"
        rel="noreferrer"
        class="inline-flex shrink-0 items-center justify-center rounded-full bg-[var(--brand-green)] px-6 py-3.5 text-sm font-extrabold text-white transition duration-300 hover:-translate-y-1 hover:brightness-110"
      >
        Solicitar cotización
        <span class="ml-2" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>


  <!-- CONTENIDO PRINCIPAL -->
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_.75fr_1fr_.9fr]">

    <!-- MARCA -->
    <div>
      <a href="#inicio" class="inline-flex" aria-label="Ir al inicio">
        <img
          src="/images/brand/logo-letreinnova.png"
          alt="LetreInnova - Publicidad que vende"
          class="h-auto w-[175px] object-contain"
        />
      </a>

      <p class="mt-5 max-w-sm text-sm leading-7 text-white/55">
        Diseñamos, fabricamos e instalamos letreros publicitarios para
        negocios y empresas que buscan destacar su marca.
      </p>

      <p class="mt-4 text-sm font-bold text-white/80">
        {site.slogan}
      </p>
    </div>


    <!-- NAVEGACIÓN -->
    <div>
      <h3 class="text-sm font-black uppercase tracking-[.12em] text-white/85">
        Navegación
      </h3>

      <nav class="mt-5 flex flex-col items-start gap-3">
        {navigation.map((item) => (
          <a
            href={item.href}
            class="footer-link text-sm text-white/50"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>


    <!-- CONTACTO -->
    <div>
      <h3 class="text-sm font-black uppercase tracking-[.12em] text-white/85">
        Contacto
      </h3>

      <div class="mt-5 flex flex-col gap-4">

        <a
          href={phone}
          class="footer-contact group"
        >
          <span class="footer-contact-icon" aria-hidden="true">
            ☎
          </span>

          <span>
            <span class="block text-xs text-white/40">Teléfono</span>
            <span class="mt-0.5 block text-sm font-bold text-white/80 transition group-hover:text-white">
              {site.phoneDisplay}
            </span>
          </span>
        </a>


        {site.email && (
          <a
            href={`mailto:${site.email}`}
            class="footer-contact group"
          >
            <span class="footer-contact-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M4 5H20C21.1046 5 22 5.89543 22 7V17C22 18.1046 21.1046 19 20 19H4C2.89543 19 2 18.1046 2 17V7C2 5.89543 2.89543 5 4 5Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
                <path
                  d="M3 7L12 13L21 7"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>

            <span class="min-w-0">
              <span class="block text-xs text-white/40">Correo</span>
              <span class="mt-0.5 block break-all text-sm font-bold text-white/80 transition group-hover:text-white">
                {site.email}
              </span>
            </span>
          </a>
        )}


        {site.address && (
          <div class="footer-contact">
            <span class="footer-contact-icon" aria-hidden="true">
              ●
            </span>

            <span>
              <span class="block text-xs text-white/40">Ubicación</span>
              <span class="mt-0.5 block text-sm font-bold text-white/80">
                {site.address}
              </span>
            </span>
          </div>
        )}

      </div>
    </div>


    <!-- REDES -->
    <div>
      <h3 class="text-sm font-black uppercase tracking-[.12em] text-white/85">
        Síguenos
      </h3>

      <p class="mt-5 text-sm leading-6 text-white/45">
        Conoce nuevos trabajos, instalaciones y proyectos realizados.
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noreferrer"
            aria-label={`Visitar ${social.label} de LetreInnova`}
            title={social.label}
            class="social-button"
          >
            <span class="social-icon" set:html={social.icon}></span>
          </a>
        ))}
      </div>
    </div>

  </div>


  <!-- PARTE INFERIOR -->
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-3 py-6 text-xs text-white/35 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}. Todos los derechos reservados.
      </p>

      <p>
        {site.slogan}
      </p>
    </div>
  </div>

</footer>
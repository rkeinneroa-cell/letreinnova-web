---
import { clients } from '../data/site';
---

<div
  id="clientes"
  class="clients-strip"
  aria-label="Marcas que confiaron en LetreInnova"
>

  <div class="clients-strip-label">
    <span></span>

    <p>Marcas que confiaron en nosotros</p>

    <span></span>
  </div>


  <div class="clients-marquee">

    <div class="clients-marquee-track">

      <div class="clients-marquee-group">
        {clients.map((client) => (
          <div class="client-logo-item">

            <img
              src={client.logo}
              alt={`Logo de ${client.name}`}
              loading="eager"
              decoding="async"
              draggable="false"
              class:list={[
                'client-logo-image',
                client.contrast === 'dark' && 'client-logo-needs-contrast'
              ]}
            />

          </div>
        ))}
      </div>


      <div class="clients-marquee-group" aria-hidden="true">
        {clients.map((client) => (
          <div class="client-logo-item">

            <img
              src={client.logo}
              alt=""
              loading="lazy"
              decoding="async"
              draggable="false"
              class:list={[
                'client-logo-image',
                client.contrast === 'dark' && 'client-logo-needs-contrast'
              ]}
            />

          </div>
        ))}
      </div>

    </div>

  </div>

</div>
---
import { clients } from '../data/site';
---
<section id="clientes" class="section-pad bg-[#f5f6f7]">
  <div class="container-site">
    <div class="mx-auto mb-12 max-w-3xl text-center" data-reveal="up">
      <p class="eyebrow text-[var(--brand-blue)]">Empresas que confían</p>
      <h2 class="section-title mt-4 text-balance">Marcas que respaldan nuestro trabajo.</h2>
    </div>
    <div class="grid grid-cols-2 border-l border-t border-black/8 sm:grid-cols-3 lg:grid-cols-5">
      {clients.map(client => (
        <div class="flex min-h-36 items-center justify-center border-b border-r border-black/8 bg-white p-7" data-reveal="scale">
          <img src={client.logo} alt={client.name} class="max-h-16 w-full object-contain grayscale opacity-65 transition hover:grayscale-0 hover:opacity-100" loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

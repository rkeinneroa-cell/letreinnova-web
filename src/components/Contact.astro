---
import { site, services } from '../data/site';
---

<section id="contacto" data-nav-theme="dark" class="section-pad contact-section relative overflow-hidden text-white">

  <div class="contact-bg"></div>

  <div class="container-site relative grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-center">

    <div data-reveal="left">
      <p class="eyebrow text-white/70">Cotiza tu proyecto</p>

      <h2 class="section-title mt-4 max-w-xl text-balance">
        Hagamos visible tu próxima idea.
      </h2>

      <p class="mt-6 max-w-lg text-base leading-7 text-white/75 sm:text-lg sm:leading-8">
        Cuéntanos qué necesitas. Te asesoramos para encontrar el tipo de letrero,
        material e iluminación que mejor se adapte a tu negocio.
      </p>

      <div class="mt-8 flex flex-col gap-3 text-sm font-bold text-white/85">
        <div class="flex items-center gap-3">
          <span class="contact-check">✓</span>
          Asesoría personalizada
        </div>

        <div class="flex items-center gap-3">
          <span class="contact-check">✓</span>
          Diseño, fabricación e instalación
        </div>

        <div class="flex items-center gap-3">
          <span class="contact-check">✓</span>
          Atención directa por WhatsApp
        </div>
      </div>

      <a
        href={`https://wa.me/${site.whatsapp}`}
        target="_blank"
        rel="noreferrer"
        class="mt-8 inline-flex items-center gap-3 text-lg font-black sm:text-xl"
      >
        <span class="contact-whatsapp-mini">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path fill="currentColor" d="M16.04 3C9.39 3 4 8.24 4 14.7c0 2.28.67 4.42 1.84 6.23L4 27l6.3-1.72a12.3 12.3 0 0 0 5.74 1.43C22.61 26.71 28 21.47 28 15S22.61 3 16.04 3Zm0 21.52a10.08 10.08 0 0 1-5.14-1.4l-.37-.22-3.74 1.02 1-3.57-.24-.38a9.35 9.35 0 0 1-1.53-5.17c0-5.27 4.4-9.56 9.82-9.56 5.41 0 9.82 4.29 9.82 9.56 0 5.43-4.4 9.72-9.62 9.72Z"/>
            <path fill="currentColor" d="M21.42 17.32c-.3-.14-1.75-.84-2.02-.93-.27-.1-.47-.14-.67.14-.2.28-.77.93-.94 1.12-.17.19-.35.21-.64.07-.3-.14-1.25-.45-2.39-1.43a8.87 8.87 0 0 1-1.65-1.99c-.17-.28-.02-.43.13-.57.13-.13.3-.33.44-.5.15-.16.2-.28.3-.47.1-.19.05-.35-.02-.5-.08-.14-.67-1.57-.92-2.15-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.35-.27.28-1.04 1-1.04 2.42s1.07 2.79 1.21 2.98c.15.19 2.1 3.13 5.09 4.39.71.3 1.26.48 1.7.61.71.22 1.36.19 1.87.12.57-.08 1.75-.7 2-1.37.24-.68.24-1.26.17-1.38-.07-.12-.27-.19-.56-.33Z"/>
          </svg>
        </span>

        {site.phoneDisplay}
      </a>
    </div>


    <form id="whatsapp-form" data-whatsapp={site.whatsapp} class="contact-form" data-reveal="right">

      <div class="grid gap-5 md:grid-cols-2">
        <label class="contact-field">
          <span>Nombre</span>
          <input id="name" required autocomplete="name" placeholder="Tu nombre" />
        </label>

        <label class="contact-field">
          <span>Teléfono</span>
          <input id="phone" inputmode="tel" autocomplete="tel" placeholder="999 999 999" />
        </label>
      </div>

      <label class="contact-field mt-5">
        <span>Tipo de letrero</span>

        <select id="service">
          <option value="">Quiero asesoría</option>
          {services.map(service => <option value={service.title}>{service.title}</option>)}
        </select>
      </label>

      <label class="contact-field mt-5">
        <span>Cuéntanos un poco más</span>

        <textarea
          id="message"
          rows="4"
          placeholder="Medidas aproximadas, ubicación, iluminación o cualquier detalle que tengas."
        ></textarea>
      </label>

      <button type="submit" class="contact-submit">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path fill="currentColor" d="M16.04 3C9.39 3 4 8.24 4 14.7c0 2.28.67 4.42 1.84 6.23L4 27l6.3-1.72a12.3 12.3 0 0 0 5.74 1.43C22.61 26.71 28 21.47 28 15S22.61 3 16.04 3Zm0 21.52a10.08 10.08 0 0 1-5.14-1.4l-.37-.22-3.74 1.02 1-3.57-.24-.38a9.35 9.35 0 0 1-1.53-5.17c0-5.27 4.4-9.56 9.82-9.56 5.41 0 9.82 4.29 9.82 9.56 0 5.43-4.4 9.72-9.62 9.72Z"/>
        </svg>

        Enviar consulta por WhatsApp
      </button>

      <p class="mt-3 text-center text-xs text-neutral-500">
        Al continuar se abrirá WhatsApp con tu mensaje preparado.
      </p>

    </form>

  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#whatsapp-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const whatsapp = form.dataset.whatsapp;

    if (!whatsapp) return;

    const name = (document.querySelector<HTMLInputElement>('#name')?.value || '').trim();
    const phone = (document.querySelector<HTMLInputElement>('#phone')?.value || '').trim();
    const service = document.querySelector<HTMLSelectElement>('#service')?.value || 'asesoría para un letrero';
    const message = (document.querySelector<HTMLTextAreaElement>('#message')?.value || '').trim();

    const text = [
      `Hola, soy ${name}. Quisiera una cotización para ${service}.`,
      phone ? `Mi teléfono es ${phone}.` : '',
      message ? `Detalle: ${message}` : ''
    ]
      .filter(Boolean)
      .join('\n');

    const url =
      `https://wa.me/${whatsapp}?text=${encodeURIComponent(text)}`;

    window.location.href = url;
  });
</script>
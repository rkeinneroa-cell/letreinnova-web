    <path fill="currentColor" d="M21.42 17.32c-.3-.14-1.75-.84-2.02-.93-.27-.1-.47-.14-.67.14-.2.28-.77.93-.94 1.12-.17.19-.35.21-.64.07-.3-.14-1.25-.45-2.39-1.43a8.87 8.87 0 0 1-1.65-1.99c-.17-.28-.02-.43.13-.57.13-.13.3-.33.44-.5.15-.16.2-.28.3-.47.1-.19.05-.35-.02-.5-.08-.14-.67-1.57-.92-2.15-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.35-.27.28-1.04 1-1.04 2.42s1.07 2.79 1.21 2.98c.15.19 2.1 3.13 5.09 4.39.71.3 1.26.48 1.7.61.71.22 1.36.19 1.87.12.57-.08 1.75-.7 2-1.37.24-.68.24-1.26.17-1.38-.07-.12-.27-.19-.56-.33Z"/>
